{
	"name": "@mousedown/portia",
	"version": "0.1.0",
	"description": "Hand Claude Code an epic, get back one reviewed pull request.",
	"license": "Apache-2.0",
	"author": "Chris Anthony",
	"homepage": "https://portia.run",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mousedown/portia.git"
	},
	"bugs": "https://github.com/mousedown/portia/issues",
	"keywords": [
		"claude-code",
		"epic",
		"orchestration",
		"worktrees",
		"jira",
		"github-issues",
		"pull-request"
	],
	"type": "module",
	"bin": {
		"portia": "src/cli/main.ts"
	},
	"files": [
		"src",
		"skills",
		".claude-plugin",
		"examples",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"engines": {
		"bun": ">=1.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run --exclude 'test/acceptance/**'",
		"test:acceptance": "vitest run test/acceptance",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"eval": "cd eval && bun src/cli.ts",
		"eval:test": "cd eval && bun test"
	},
	"dependencies": {
		"@clack/core": "^1.5.1",
		"@clack/prompts": "^1.8.1",
		"picomatch": "^4.0.7",
		"pixelmatch": "^8.0.0",
		"playwright": "^1.64.1",
		"pngjs": "^7.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/picomatch": "^4.0.3",
		"@types/pngjs": "^6.0.5",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
