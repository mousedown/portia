{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"types": ["bun", "node"],
		"skipLibCheck": true,
		"resolveJsonModule": true
	},
	"include": ["src", "test", "examples", "vitest.config.ts"]
}
